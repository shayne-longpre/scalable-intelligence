{
  "providers": [
    {
      "name": "openai",
      "kind": "openai",
      "api_key_env": "OPENAI_API_KEY",
      "base_url": "https://api.openai.com/v1"
    },
    {
      "name": "openrouter",
      "kind": "openrouter",
      "api_key_env": "OPENROUTER_API_KEY",
      "headers": {
        "HTTP-Referer": "https://example.org/ai-council",
        "X-Title": "AI Council"
      }
    },
    {
      "name": "anthropic",
      "kind": "anthropic",
      "api_key_env": "ANTHROPIC_API_KEY",
      "base_url": "https://api.anthropic.com/v1"
    }
  ],
  "models": [
    {
      "name": "openai_participant",
      "provider": "openai",
      "model": "REPLACE_WITH_OPENAI_MODEL",
      "params": {
        "temperature": 0.7,
        "max_tokens": 1200
      }
    },
    {
      "name": "openrouter_participant",
      "provider": "openrouter",
      "model": "REPLACE_WITH_OPENROUTER_MODEL",
      "params": {
        "temperature": 0.7,
        "max_tokens": 1200
      }
    },
    {
      "name": "claude_participant",
      "provider": "anthropic",
      "model": "REPLACE_WITH_ANTHROPIC_MODEL",
      "params": {
        "temperature": 0.7,
        "max_tokens": 1200
      }
    }
  ]
}
