{
  "name": "pair_adaptive_openrouter",
  "run": {
    "output_dir": "runs",
    "max_context_turns": 80,
    "max_model_calls": 20,
    "max_reported_cost_usd": 0.03
  },
  "providers": [
    {
      "name": "openrouter",
      "kind": "openrouter",
      "api_key_env": "OPENROUTER_API_KEY",
      "headers": {
        "HTTP-Referer": "https://example.org/ai-council",
        "X-Title": "AI Council Pair Pilot"
      },
      "timeout_seconds": 120
    }
  ],
  "models": [
    {
      "name": "qwen_30b",
      "provider": "openrouter",
      "model": "qwen/qwen3-30b-a3b-instruct-2507",
      "params": {
        "temperature": 0.7,
        "max_tokens": 1000
      }
    },
    {
      "name": "mistral_small",
      "provider": "openrouter",
      "model": "mistralai/mistral-small-24b-instruct-2501",
      "params": {
        "temperature": 0.7,
        "max_tokens": 1000
      }
    }
  ],
  "participants": [
    { "id": "P1", "model": "qwen_30b" },
    { "id": "P2", "model": "mistral_small" }
  ],
  "monitor": {
    "enabled": true,
    "strict": false
  },
  "prompt_overrides": {
    "final_judgment": "Privately submit your final judgment as one compact JSON object only. Do not use markdown fences or prose outside JSON. Use exactly these top-level keys: participant_id, phase, ranking, confidence, criteria, evidence, uncertainties, updates, next_evidence_needed, final_reflection. Keep ranking as an ordered list of participant IDs. Confidence must be a JSON number from 0 to 1, not a string and not a percentage. Base the ranking on the full 1-1 dialogue: questions asked, answers, follow-up probes, revisions, and changes in your judgment over rounds. Keep criteria to at most 5 short strings. Keep evidence to at most 5 short strings. Keep uncertainties, updates, and next_evidence_needed to at most 3 short strings each. Keep final_reflection under 80 words."
  },
  "protocol": {
    "name": "pair_adaptive_k3",
    "turn_order": "rotate",
    "phases": [
      {
        "name": "private_test_design",
        "kind": "private_reflection",
        "prompt": "private_test_design",
        "visibility": "private"
      },
      {
        "name": "pair_round_1",
        "kind": "public_round_robin",
        "prompt": "pair_adaptive_probe",
        "rounds": 1,
        "visibility": "public"
      },
      {
        "name": "checkpoint_1",
        "kind": "private_judgment",
        "prompt": "pair_checkpoint_judgment",
        "visibility": "private",
        "require_json": true,
        "required_keys": [
          "participant_id",
          "phase",
          "ranking",
          "confidence",
          "criteria",
          "evidence",
          "uncertainties",
          "updates",
          "next_evidence_needed"
        ]
      },
      {
        "name": "pair_round_2",
        "kind": "public_round_robin",
        "prompt": "pair_adaptive_probe",
        "rounds": 1,
        "visibility": "public"
      },
      {
        "name": "checkpoint_2",
        "kind": "private_judgment",
        "prompt": "pair_checkpoint_judgment",
        "visibility": "private",
        "require_json": true,
        "required_keys": [
          "participant_id",
          "phase",
          "ranking",
          "confidence",
          "criteria",
          "evidence",
          "uncertainties",
          "updates",
          "next_evidence_needed"
        ]
      },
      {
        "name": "pair_round_3",
        "kind": "public_round_robin",
        "prompt": "pair_adaptive_probe",
        "rounds": 1,
        "visibility": "public"
      },
      {
        "name": "final_judgment",
        "kind": "private_judgment",
        "prompt": "final_judgment",
        "visibility": "private",
        "require_json": true,
        "required_keys": [
          "participant_id",
          "phase",
          "ranking",
          "confidence",
          "criteria",
          "evidence",
          "uncertainties",
          "updates",
          "next_evidence_needed",
          "final_reflection"
        ]
      }
    ]
  }
}
