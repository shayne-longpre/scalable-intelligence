{
  "name": "independent_judges_six_candidate_pilot",
  "run": {
    "output_dir": "runs",
    "max_context_turns": 40,
    "max_parallel_calls": 6,
    "max_model_calls": 110,
    "max_reported_cost_usd": 3.0,
    "structured_json_retries": 1,
    "visible_text_retries": 1
  },
  "context": {
    "mode": "private_memory",
    "max_public_turns": 0,
    "max_private_turns": 12,
    "max_stream_turns": 8
  },
  "providers": [
    {
      "name": "openrouter",
      "kind": "openrouter",
      "api_key_env": "OPENROUTER_API_KEY",
      "headers": {
        "HTTP-Referer": "https://example.org/ai-council",
        "X-Title": "AI Council Independent Judge Pilot"
      },
      "timeout_seconds": 90
    }
  ],
  "models": [
    {
      "name": "judge_sonnet_5",
      "provider": "openrouter",
      "model": "anthropic/claude-sonnet-5",
      "params": {
        "max_tokens": 2500,
        "reasoning": { "effort": "low" }
      }
    },
    {
      "name": "judge_gemini_31_pro",
      "provider": "openrouter",
      "model": "google/gemini-3.1-pro-preview",
      "params": {
        "temperature": 0.4,
        "max_tokens": 4000,
        "reasoning": { "effort": "low" }
      },
      "recovery_params": {
        "max_tokens": 4000,
        "reasoning": { "effort": "low" }
      }
    },
    {
      "name": "deepseek_v4_pro",
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4-pro",
      "params": {
        "temperature": 0.5,
        "max_tokens": 1800,
        "reasoning": { "effort": "none" }
      }
    },
    {
      "name": "gpt_54_mini",
      "provider": "openrouter",
      "model": "openai/gpt-5.4-mini",
      "params": { "max_tokens": 1800 }
    },
    {
      "name": "gpt_54_nano",
      "provider": "openrouter",
      "model": "openai/gpt-5.4-nano",
      "params": { "max_tokens": 1800 }
    },
    {
      "name": "grok_43",
      "provider": "openrouter",
      "model": "x-ai/grok-4.3",
      "params": {
        "temperature": 0.5,
        "max_tokens": 1800,
        "reasoning": { "effort": "none" }
      }
    },
    {
      "name": "deepseek_v32",
      "provider": "openrouter",
      "model": "deepseek/deepseek-v3.2",
      "params": { "temperature": 0.5, "max_tokens": 1800 }
    },
    {
      "name": "claude_haiku_45",
      "provider": "openrouter",
      "model": "anthropic/claude-haiku-4.5",
      "params": { "max_tokens": 1800 }
    }
  ],
  "participants": [
    { "id": "P1", "model": "deepseek_v4_pro", "system_prompt": "blind_evaluation_candidate" },
    { "id": "P2", "model": "gpt_54_mini", "system_prompt": "blind_evaluation_candidate" },
    { "id": "P3", "model": "gpt_54_nano", "system_prompt": "blind_evaluation_candidate" },
    { "id": "P4", "model": "grok_43", "system_prompt": "blind_evaluation_candidate" },
    { "id": "P5", "model": "deepseek_v32", "system_prompt": "blind_evaluation_candidate" },
    { "id": "P6", "model": "claude_haiku_45", "system_prompt": "blind_evaluation_candidate" }
  ],
  "judges": [
    { "id": "J2", "model": "judge_gemini_31_pro", "system_prompt": "independent_intelligence_judge" },
    { "id": "J1", "model": "judge_sonnet_5", "system_prompt": "independent_intelligence_judge" }
  ],
  "monitor": {
    "enabled": true,
    "strict": false
  },
  "protocol": {
    "name": "independent_judges_one_pass_n6",
    "turn_order": "fixed",
    "phases": [
      {
        "name": "judge_ranking",
        "kind": "independent_judge_ranking",
        "prompt": "independent_judge_probe",
        "question_prompt": "independent_judge_probe",
        "answer_prompt": "independent_judge_answer",
        "assessment_prompt": "independent_judge_evidence_card",
        "ranking_prompt": "independent_judge_ranking",
        "rounds": 1,
        "probes_per_round": 4,
        "adaptive_probes_per_round": 1,
        "max_adaptive_candidates": 4,
        "recovery_model_params": {
          "max_tokens": 2500,
          "reasoning": { "effort": "none" }
        },
        "visibility": "private"
      }
    ]
  },
  "metadata": {
    "design": "Two judges independently administer one four-probe common battery to six candidates.",
    "adaptivity": "Disabled in this pilot; rounds greater than one enable bounded selective follow-up.",
    "gold_prior": "data/model_catalog.openrouter.json"
  }
}
