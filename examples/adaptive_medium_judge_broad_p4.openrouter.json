{
  "name": "adaptive_medium_judge_broad_p4",
  "run": {
    "output_dir": "runs",
    "max_context_turns": 20,
    "max_parallel_calls": 4,
    "max_model_calls": 75,
    "max_reported_cost_usd": 5.0,
    "structured_json_retries": 1,
    "visible_text_retries": 1
  },
  "context": {
    "mode": "private_memory",
    "max_public_turns": 0,
    "max_private_turns": 8,
    "max_stream_turns": 4
  },
  "providers": [
    {
      "name": "openrouter",
      "kind": "openrouter",
      "api_key_env": "OPENROUTER_API_KEY",
      "headers": {
        "HTTP-Referer": "https://example.org/ai-council",
        "X-Title": "AI Council Adaptive Medium Judge Pilot"
      },
      "timeout_seconds": 180,
      "request_retries": 2
    }
  ],
  "models": [
    {
      "name": "judge_gpt_54_mini",
      "provider": "openrouter",
      "model": "openai/gpt-5.4-mini",
      "params": {
        "max_tokens": 6000,
        "reasoning": { "effort": "medium" }
      },
      "recovery_params": {
        "max_tokens": 5000,
        "reasoning": { "effort": "low" }
      }
    },
    {
      "name": "claude_fable_5",
      "provider": "openrouter",
      "model": "anthropic/claude-fable-5",
      "params": {
        "max_tokens": 6000,
        "reasoning": { "effort": "medium" }
      }
    },
    {
      "name": "gpt_5_mini",
      "provider": "openrouter",
      "model": "openai/gpt-5-mini",
      "params": {
        "max_tokens": 5000,
        "reasoning": { "effort": "medium" }
      }
    },
    {
      "name": "gpt_4o_2024_11_20",
      "provider": "openrouter",
      "model": "openai/gpt-4o-2024-11-20",
      "params": {
        "temperature": 0.3,
        "max_tokens": 3000
      }
    },
    {
      "name": "llama_31_8b",
      "provider": "openrouter",
      "model": "meta-llama/llama-3.1-8b-instruct",
      "params": {
        "temperature": 0.3,
        "max_tokens": 3000
      }
    }
  ],
  "participants": [
    { "id": "P1", "model": "gpt_4o_2024_11_20", "system_prompt": "blind_evaluation_candidate" },
    { "id": "P2", "model": "claude_fable_5", "system_prompt": "blind_evaluation_candidate" },
    { "id": "P3", "model": "llama_31_8b", "system_prompt": "blind_evaluation_candidate" },
    { "id": "P4", "model": "gpt_5_mini", "system_prompt": "blind_evaluation_candidate" }
  ],
  "judges": [
    { "id": "J1", "model": "judge_gpt_54_mini", "system_prompt": "independent_intelligence_judge" }
  ],
  "monitor": {
    "enabled": true,
    "strict": false
  },
  "protocol": {
    "name": "adaptive_probe_waves",
    "turn_order": "fixed",
    "phases": [
      {
        "name": "judge_ranking",
        "kind": "independent_judge_ranking",
        "prompt": "adaptive_judge_probe",
        "question_prompt": "adaptive_judge_probe",
        "answer_prompt": "independent_judge_answer",
        "assessment_prompt": "independent_judge_probe_comparison",
        "ranking_prompt": "independent_judge_wave_judgment",
        "probe_schedule": [4, 1, 1, 1, 1],
        "adaptive_targeting": "judge_selected",
        "max_adaptive_candidates": 3,
        "recovery_model_params": {
          "max_tokens": 5000,
          "reasoning": { "effort": "low" }
        },
        "visibility": "private"
      }
    ]
  },
  "metadata": {
    "design": "Medium judge over a broad four-candidate capability ladder.",
    "stopping_points": [4, 5, 6, 7, 8],
    "gold_prior": "data/model_catalog.openrouter.json"
  }
}
