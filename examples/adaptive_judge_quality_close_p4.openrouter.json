{
  "name": "adaptive_judge_quality_close_p4_r1",
  "run": {
    "output_dir": "runs",
    "max_context_turns": 20,
    "max_parallel_calls": 4,
    "max_model_calls": 120,
    "max_reported_cost_usd": 12.0,
    "structured_json_retries": 2,
    "visible_text_retries": 1
  },
  "context": {
    "mode": "private_memory",
    "max_public_turns": 0,
    "max_private_turns": 8,
    "max_stream_turns": 4
  },
  "providers": [
    {
      "name": "openrouter",
      "kind": "openrouter",
      "api_key_env": "OPENROUTER_API_KEY",
      "headers": {
        "HTTP-Referer": "https://example.org/ai-council",
        "X-Title": "AI Council Matched Judge Quality Study"
      },
      "timeout_seconds": 300,
      "request_retries": 2
    }
  ],
  "models": [
    {
      "name": "judge_sol_56",
      "provider": "openrouter",
      "model": "openai/gpt-5.6-sol",
      "params": {
        "max_tokens": 7000,
        "reasoning": { "effort": "xhigh" }
      },
      "recovery_params": {
        "max_tokens": 3000,
        "reasoning": { "effort": "none" }
      }
    },
    {
      "name": "judge_gpt_54_mini",
      "provider": "openrouter",
      "model": "openai/gpt-5.4-mini",
      "params": {
        "max_tokens": 6000,
        "reasoning": { "effort": "medium" }
      },
      "recovery_params": {
        "max_tokens": 5000,
        "reasoning": { "effort": "low" }
      }
    },
    {
      "name": "claude_fable_5",
      "provider": "openrouter",
      "model": "anthropic/claude-fable-5",
      "params": {
        "max_tokens": 8000,
        "reasoning": { "effort": "medium" }
      },
      "recovery_params": {
        "max_tokens": 8000,
        "reasoning": { "effort": "low" }
      }
    },
    {
      "name": "gpt_54",
      "provider": "openrouter",
      "model": "openai/gpt-5.4",
      "params": {
        "max_tokens": 8000,
        "reasoning": { "effort": "medium" }
      },
      "recovery_params": {
        "max_tokens": 8000,
        "reasoning": { "effort": "low" }
      }
    },
    {
      "name": "gemini_35_flash",
      "provider": "openrouter",
      "model": "google/gemini-3.5-flash",
      "params": {
        "temperature": 0.3,
        "max_tokens": 8000,
        "reasoning": { "effort": "low" }
      },
      "recovery_params": {
        "max_tokens": 8000,
        "reasoning": { "effort": "low" }
      }
    },
    {
      "name": "claude_sonnet_46",
      "provider": "openrouter",
      "model": "anthropic/claude-sonnet-4.6",
      "params": {
        "max_tokens": 12000,
        "reasoning": { "max_tokens": 2000 }
      },
      "recovery_params": {
        "max_tokens": 12000,
        "reasoning": { "max_tokens": 2000 }
      }
    }
  ],
  "participants": [
    { "id": "P1", "model": "claude_sonnet_46", "system_prompt": "blind_evaluation_candidate" },
    { "id": "P2", "model": "claude_fable_5", "system_prompt": "blind_evaluation_candidate" },
    { "id": "P3", "model": "gemini_35_flash", "system_prompt": "blind_evaluation_candidate" },
    { "id": "P4", "model": "gpt_54", "system_prompt": "blind_evaluation_candidate" }
  ],
  "judges": [
    { "id": "J1", "model": "judge_sol_56", "system_prompt": "independent_intelligence_judge" },
    { "id": "J2", "model": "judge_gpt_54_mini", "system_prompt": "independent_intelligence_judge" }
  ],
  "monitor": {
    "enabled": true,
    "strict": false
  },
  "protocol": {
    "name": "adaptive_probe_waves",
    "turn_order": "fixed",
    "phases": [
      {
        "name": "judge_ranking",
        "kind": "independent_judge_ranking",
        "prompt": "adaptive_judge_probe",
        "question_prompt": "adaptive_judge_probe",
        "answer_prompt": "independent_judge_answer",
        "assessment_prompt": "independent_judge_probe_comparison",
        "ranking_prompt": "independent_judge_wave_judgment",
        "probe_schedule": [4, 1, 1, 1],
        "adaptive_targeting": "judge_selected",
        "max_adaptive_candidates": 3,
        "visibility": "private"
      }
    ]
  },
  "metadata": {
    "study": "adaptive_judge_quality_close_p4_v1",
    "replicate_id": "r1",
    "design": "Matched close-roster replication comparing two independent judge models.",
    "stopping_points": [4, 5, 6, 7],
    "gold_prior": "data/model_catalog.openrouter.json",
    "prompt_version": "2026-07-20-adaptive-waves-v4",
    "taxonomy_version": "2026-07-20.4",
    "anonymization": {
      "P1": "claude_sonnet_46",
      "P2": "claude_fable_5",
      "P3": "gemini_35_flash",
      "P4": "gpt_54"
    }
  }
}
